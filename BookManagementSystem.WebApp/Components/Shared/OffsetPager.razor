<div class="offset-pager">
    <div class="offset-pager-summary" aria-live="polite">
        @RangeText
    </div>

    <div class="offset-pager-size">
        <label for="@_pageSizeId">Rows per page</label>
        <select id="@_pageSizeId"
                value="@PageSize"
                @onchange="HandlePageSizeChangedAsync"
                disabled="@IsLoading"
                aria-label="Rows per page">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
    </div>

    <nav class="offset-pager-navigation" aria-label="Table pagination">
        <button type="button"
                class="offset-page-button offset-page-direction"
                disabled="@(IsLoading || CurrentPage <= 1)"
                @onclick="() => PageChanged.InvokeAsync(CurrentPage - 1)"
                aria-label="Go to previous page">
            <span aria-hidden="true">&lsaquo;</span>
        </button>

        @foreach (var page in VisiblePages)
        {
            if (page.HasValue)
            {
                var pageNumber = page.Value;
                <button type="button"
                        @key="pageNumber"
                        class="@PageButtonClass(pageNumber)"
                        disabled="@IsLoading"
                        @onclick="() => PageChanged.InvokeAsync(pageNumber)"
                        aria-label="@($"Go to page {pageNumber}")"
                        aria-current="@(pageNumber == CurrentPage ? "page" : null)">
                    @pageNumber
                </button>
            }
            else
            {
                <span class="offset-page-ellipsis" aria-hidden="true">&hellip;</span>
            }
        }

        <button type="button"
                class="offset-page-button offset-page-direction"
                disabled="@(IsLoading || CurrentPage >= PageCount)"
                @onclick="() => PageChanged.InvokeAsync(CurrentPage + 1)"
                aria-label="Go to next page">
            <span aria-hidden="true">&rsaquo;</span>
        </button>
    </nav>
</div>

@code {
    private readonly string _pageSizeId = $"page-size-{Guid.NewGuid():N}";

    [Parameter] public int Offset { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private string RangeText => TotalCount == 0
        ? "Showing 0–0 of 0"
        : $"Showing {Offset + 1}–{Math.Min(Offset + PageSize, TotalCount)} of {TotalCount}";

    private IEnumerable<int?> VisiblePages
    {
        get
        {
            if (PageCount <= 7)
                return Enumerable.Range(1, PageCount).Select(x => (int?)x);

            var pages = new List<int?> { 1 };
            var start = Math.Max(2, CurrentPage - 1);
            var end = Math.Min(PageCount - 1, CurrentPage + 1);

            if (start > 2)
                pages.Add(null);

            for (var page = start; page <= end; page++)
                pages.Add(page);

            if (end < PageCount - 1)
                pages.Add(null);

            pages.Add(PageCount);
            return pages;
        }
    }

    private string PageButtonClass(int page) =>
        page == CurrentPage
            ? "offset-page-button active"
            : "offset-page-button";

    private async Task HandlePageSizeChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize))
            await PageSizeChanged.InvokeAsync(pageSize);
    }
}
