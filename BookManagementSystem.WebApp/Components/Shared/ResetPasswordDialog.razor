<FormEntityDialogCore TModel="ResetPasswordModel"
                      Model="@_model"
                      DialogTitle="Reset Password"
                      SubmitLabel="Reset password"
                      SupportingText="@SupportingText"
                      DialogWidth="MaxWidth.Small"
                      Submit="SubmitAsync"
                      OnSuccess="@OnSuccess"
                      IsOpen="@IsOpen"
                      IsOpenChanged="@IsOpenChanged"
                      ReturnFocusElementId="@ReturnFocusElementId">
    <FormFields Context="model">
        <MudTextField @bind-Value="model.NewPassword"
                      For="@(() => model.NewPassword)"
                      Label="New Password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true"
                      AutoFocus="true"
                      Class="mb-3" />
        <MudTextField @bind-Value="model.ConfirmPassword"
                      For="@(() => model.ConfirmPassword)"
                      Label="Confirm Password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Required="true" />
    </FormFields>
</FormEntityDialogCore>

@code {
    private ResetPasswordModel _model = new();
    private bool _wasOpen;

    private string SupportingText =>
        string.IsNullOrWhiteSpace(UserEmail)
            ? "Choose a new password for this user."
            : $"Choose a new password for {UserEmail}.";

    [Parameter] public string? UserEmail { get; set; }
    [Parameter, EditorRequired] public Func<string, Task<FormSubmitResult>> Submit { get; set; } = default!;
    [Parameter] public EventCallback<FormSubmitResult> OnSuccess { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? ReturnFocusElementId { get; set; }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
            _model = new ResetPasswordModel();

        _wasOpen = IsOpen;
    }

    private Task<FormSubmitResult> SubmitAsync(ResetPasswordModel model) => Submit(model.NewPassword);

    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords must match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
