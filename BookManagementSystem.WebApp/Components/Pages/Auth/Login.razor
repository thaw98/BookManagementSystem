@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Login — BMS</PageTitle>

<MudPaper Class="login-card" Elevation="0">
    <div class="login-brand">
        <div class="brand-logo">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" />
        </div>
        <div>
            <h1 class="login-title">BMS</h1>
            <p class="login-subtitle">Sign in to the Library System</p>
        </div>
    </div>

    @if (Error == "1")
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            Invalid email or password.
        </MudAlert>
    }
    else if (Error == "deleted")
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            Your account has been deleted. Contact an administrator.
        </MudAlert>
    }

    <form method="post" action="/account/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="mb-3">
            <label for="email" class="login-label">Email</label>
            <input id="email"
                   name="email"
                   type="email"
                   class="bms-input"
                   placeholder="you@bms.com"
                   required
                   autocomplete="username" />
        </div>

        <div class="mb-4">
            <label for="password" class="login-label">Password</label>
            <div class="login-password-input">
                <input id="password"
                       name="password"
                       type="@LoginPasswordInputType"
                       class="bms-input"
                       placeholder="Enter password"
                       required
                       autocomplete="current-password" />
                <button type="button"
                        class="login-password-toggle"
                        aria-label="@LoginPasswordToggleLabel"
                        title="@LoginPasswordToggleLabel"
                        aria-pressed="@LoginPasswordAriaPressed"
                        @onclick="ToggleLoginPasswordVisibility">
                    <MudIcon Icon="@LoginPasswordToggleIcon" Size="Size.Small" aria-hidden="true" />
                </button>
            </div>
        </div>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Class="login-submit">
            Sign In
        </MudButton>
    </form>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool _loginPasswordVisible;

    private string LoginPasswordInputType => _loginPasswordVisible ? "text" : "password";

    private string LoginPasswordToggleIcon => _loginPasswordVisible
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private string LoginPasswordToggleLabel => _loginPasswordVisible
        ? "Hide password"
        : "Show password";

    private string LoginPasswordAriaPressed => _loginPasswordVisible ? "true" : "false";

    private void ToggleLoginPasswordVisibility()
    {
        _loginPasswordVisible = !_loginPasswordVisible;
    }
}
