@page "/authors"
@attribute [Authorize(Roles = "Librarian")]
@inherits ServerPagedComponentBase<AuthorDto>
@inject ApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Authors — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Authors</h1>
        <p class="page-subtitle">Maintain the author directory</p>
    </div>
    <MudButton id="@AddTriggerId"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Add Author
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<CreateEntityDialog TModel="AuthorForm"
                    @bind-IsOpen="_createDialogOpen"
                    Model="@_createForm"
                    EntityLabel="Author"
                    SupportingText="Add an author to the directory."
                    DialogWidth="MaxWidth.Small"
                    Submit="CreateAuthorAsync"
                    OnSuccess="OnAuthorCreatedAsync"
                    ReturnFocusElementId="@AddTriggerId">
    <FormFields Context="model">
        <MudTextField @bind-Value="model.Name"
                      For="@(() => model.Name)"
                      Label="Author name"
                      Variant="Variant.Outlined"
                      Required="true"
                      AutoFocus="true" />
    </FormFields>
</CreateEntityDialog>

<EditEntityDialog TModel="AuthorForm"
                  @bind-IsOpen="_editDialogOpen"
                  Model="@_editForm"
                  EntityLabel="Author"
                  SupportingText="Update the author's directory name."
                  DialogWidth="MaxWidth.Small"
                  Submit="UpdateAuthorAsync"
                  OnSuccess="OnAuthorUpdatedAsync"
                  ReturnFocusElementId="@_editReturnFocusId">
    <FormFields Context="model">
        <MudTextField @bind-Value="model.Name"
                      For="@(() => model.Name)"
                      Label="Author name"
                      Variant="Variant.Outlined"
                      Required="true"
                      AutoFocus="true" />
    </FormFields>
</EditEntityDialog>

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <div class="d-flex align-center gap-2 flex-wrap">
        <MudTextField T="string"
                      @bind-Value="SearchText"
                      Label="Search author"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Style="max-width:320px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">Search</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearFiltersAsync">Clear</MudButton>
    </div>
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}

<MudPaper Class="bms-panel" Elevation="0">
    <MudTable T="AuthorDto"
              @ref="Table"
              ServerData="LoadServerDataAsync"
              RowsPerPage="10"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Class="bms-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="AuthorDto" SortLabel="name">Author Name</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Author Name">@context.Name</MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton id="@EditTriggerId(context.Id)"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OpenEditDialog(context)"
                                   aria-label="@($"Edit {context.Name}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => DeleteAsync(context.Id)"
                                   aria-label="@($"Delete {context.Name}")" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No authors found.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
            </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string AddTriggerId = "add-author-trigger";
    private AuthorForm _createForm = new();
    private AuthorForm _editForm = new();
    private bool _createDialogOpen;
    private bool _editDialogOpen;
    private string? _editReturnFocusId;
    private string? SearchText { get; set; }
    private string? _appliedSearchText;
    private string? Message { get; set; }

    protected override Task<Result<OffsetPagedResult<AuthorDto>>> FetchPageAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        var queryParameters = new List<string>
        {
            $"page={state.Page + 1}",
            $"pageSize={state.PageSize}"
        };
        if (!string.IsNullOrWhiteSpace(_appliedSearchText))
            queryParameters.Add($"search={Uri.EscapeDataString(_appliedSearchText)}");
        AddSortingParameters(queryParameters, state);

        return Api.GetAsync<OffsetPagedResult<AuthorDto>>(
            "api/Author/paged?" + string.Join("&", queryParameters),
            cancellationToken);
    }

    protected override void OnPageLoadSucceeded() => Message = null;

    protected override void OnPageLoadFailed(string message) => Message = message;

    private async Task SearchAsync()
    {
        _appliedSearchText = string.IsNullOrWhiteSpace(SearchText)
            ? null
            : SearchText.Trim();
        await ReloadFromFirstPageAsync();
    }

    private async Task ClearFiltersAsync()
    {
        SearchText = null;
        _appliedSearchText = null;
        await ReloadFromFirstPageAsync();
    }

    private void OpenCreateDialog()
    {
        _createForm = new AuthorForm();
        Message = null;
        _createDialogOpen = true;
    }

    private void OpenEditDialog(AuthorDto author)
    {
        _editForm = new AuthorForm { Id = author.Id, Name = author.Name };
        _editReturnFocusId = EditTriggerId(author.Id);
        Message = null;
        _editDialogOpen = true;
    }

    private async Task<FormSubmitResult> CreateAuthorAsync(AuthorForm form)
    {
        var result = await Api.PostAsync<long>("api/Author", new CreateAuthorRequest { Name = form.Name.Trim() });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task<FormSubmitResult> UpdateAuthorAsync(AuthorForm form)
    {
        var result = await Api.PutAsync<AuthorDto>(
            $"api/Author/{form.Id}",
            new UpdateAuthorRequest { Name = form.Name.Trim() });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task OnAuthorCreatedAsync(FormSubmitResult result)
    {
        Message = null;
        await ReloadFromFirstPageAsync();
        Snackbar.Add(result.Message ?? "Author created successfully.", Severity.Success);
    }

    private async Task OnAuthorUpdatedAsync(FormSubmitResult result)
    {
        Message = null;
        await ReloadCurrentPageAsync();
        Snackbar.Add(result.Message ?? "Author updated successfully.", Severity.Success);
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Author/{id}");
        if (result.IsSuccess)
        {
            await ReloadAfterDeleteAsync();
            Snackbar.Add(result.Message ?? "Author deleted successfully.", Severity.Success);
        }
        else
        {
            Message = result.Message;
        }
    }

    private static string EditTriggerId(long id) => $"edit-author-{id}";

    private sealed class AuthorForm
    {
        public long Id { get; set; }

        [Required(ErrorMessage = "Author name is required.")]
        public string Name { get; set; } = "";
    }
}
