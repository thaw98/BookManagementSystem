@page "/roles"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api

<PageTitle>Roles — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Roles</h1>
        <p class="page-subtitle">Define and maintain access roles</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <MudTextField @bind-Value="Filter"
                  Label="Filter by name"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Margin="Margin.Dense"
                  Style="max-width:320px;" />
</MudPaper>

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <h3 class="section-title">@(Form.Id == 0 ? "Add Role" : "Edit Role")</h3>
    <EditForm Model="Form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Form.Name"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="@EditingProtectedName" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="Form.Description"
                              Label="Description"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Clear">Clear</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

<MudPaper Class="bms-panel" Elevation="0">
    <MudTable Items="@FilteredRoles.ToList()" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="bms-table">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => Edit(context)" aria-label="Edit" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               Disabled="@context.IsProtected"
                               OnClick="() => DeleteAsync(context.Id)"
                               aria-label="Delete" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">No roles found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<RoleListDto> Roles { get; set; } = [];
    private RoleForm Form { get; set; } = new();
    private string? Filter { get; set; }
    private string? Message { get; set; }
    private bool EditingProtectedName => Form.Id is 1 or 2 or 3;

    private IEnumerable<RoleListDto> FilteredRoles =>
        Roles.Where(x => string.IsNullOrWhiteSpace(Filter) || x.Name.Contains(Filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<RoleListDto>>("api/Role");
        Roles = result.Data ?? [];
        Message = result.IsSuccess ? null : result.Message;
    }

    private void Edit(RoleListDto role)
    {
        Form = new RoleForm { Id = role.Id, Name = role.Name, Description = role.Description };
    }

    private void Clear() => Form = new RoleForm();

    private async Task SaveAsync()
    {
        var succeeded = false;
        if (Form.Id == 0)
        {
            var result = await Api.PostAsync<long>("api/Role", new CreateRoleRequest { Name = Form.Name, Description = Form.Description });
            Message = result.Message;
            succeeded = result.IsSuccess;
        }
        else
        {
            var result = await Api.PutAsync<RoleDetailDto>($"api/Role/{Form.Id}", new UpdateRoleRequest { Name = Form.Name, Description = Form.Description });
            Message = result.Message;
            succeeded = result.IsSuccess;
        }

        if (succeeded)
        {
            Clear();
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Role/{id}");
        Message = result.Message;
        await LoadAsync();
    }

    private sealed class RoleForm
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }
}
