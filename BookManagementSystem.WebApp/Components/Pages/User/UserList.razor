@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api

<PageTitle>Users — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Invite librarians and members to the library</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--border);border-radius:14px;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="EmailFilter"
                          Label="Filter by email"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string"
                       Value="@(RoleFilter ?? string.Empty)"
                       ValueChanged="OnRoleFilterChanged"
                       Label="Role"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@string.Empty">All roles</MudSelectItem>
                @foreach (var role in Roles)
                {
                    <MudSelectItem Value="@role.Name">@role.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--border);border-radius:14px;">
    <MudText Typo="Typo.subtitle1" Style="font-weight:700;" Class="mb-3">
        @(Form.Id == 0 ? "Add User" : "Edit User")
    </MudText>
    <EditForm Model="Form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Form.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="long"
                           @bind-Value="Form.RoleId"
                           Label="Role"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var role in Roles)
                    {
                        <MudSelectItem T="long" Value="@role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="Form.Password"
                              Label="Password"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudCheckBox @bind-Value="Form.IsActive" Label="Active" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Clear">Clear</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

<MudPaper Elevation="0" Style="border:1px solid var(--border);border-radius:14px;overflow:hidden;">
    <MudTable Items="@FilteredUsers.ToList()" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Email</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Active</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Role">
                <span class="role-badge @context.RoleName.ToLowerInvariant()">@context.RoleName</span>
            </MudTd>
            <MudTd DataLabel="Active">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Yes" : "No")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => Edit(context)" aria-label="Edit" />
                <MudIconButton Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" Color="Color.Warning" OnClick="() => ResetPasswordAsync(context.Id)" aria-label="Reset password" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context.Id)" aria-label="Delete" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">No users found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<UserListDto> Users { get; set; } = [];
    private List<RoleListDto> Roles { get; set; } = [];
    private UserForm Form { get; set; } = new();
    private string? EmailFilter { get; set; }
    private string? RoleFilter { get; set; }
    private string? Message { get; set; }

    private IEnumerable<UserListDto> FilteredUsers => Users.Where(x =>
        (string.IsNullOrWhiteSpace(EmailFilter) || x.Email.Contains(EmailFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(RoleFilter) || x.RoleName == RoleFilter));

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
        await LoadUsersAsync();
        Form.RoleId = Roles.FirstOrDefault()?.Id ?? 0;
    }

    private async Task LoadUsersAsync()
    {
        var result = await Api.GetAsync<List<UserListDto>>("api/User");
        Users = result.Data ?? [];
        Message = result.IsSuccess ? Message : result.Message;
    }

    private async Task LoadRolesAsync()
    {
        var result = await Api.GetAsync<List<RoleListDto>>("api/Role");
        Roles = result.Data ?? [];
    }

    private Task OnRoleFilterChanged(string value)
    {
        RoleFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        return Task.CompletedTask;
    }

    private void Edit(UserListDto user)
    {
        Form = new UserForm { Id = user.Id, Email = user.Email, RoleId = user.RoleId, IsActive = user.IsActive };
    }

    private void Clear() => Form = new UserForm { RoleId = Roles.FirstOrDefault()?.Id ?? 0, IsActive = true };

    private async Task SaveAsync()
    {
        if (Form.Id == 0)
        {
            var result = await Api.PostAsync<long>("api/User", new CreateUserRequest
            {
                Email = Form.Email,
                Password = Form.Password,
                RoleId = Form.RoleId,
                IsActive = Form.IsActive
            });
            Message = result.Message;
        }
        else
        {
            var result = await Api.PutAsync<UserDetailDto>($"api/User/{Form.Id}", new UpdateUserRequest
            {
                Email = Form.Email,
                RoleId = Form.RoleId,
                IsActive = Form.IsActive
            });
            Message = result.Message;
        }

        Clear();
        await LoadUsersAsync();
    }

    private async Task ResetPasswordAsync(long id)
    {
        var password = string.IsNullOrWhiteSpace(Form.Password) ? "password123" : Form.Password;
        var result = await Api.PostAsync<bool>($"api/User/{id}/ResetPassword", new ResetPasswordRequest { Password = password });
        Message = result.Message;
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/User/{id}");
        Message = result.Message;
        await LoadUsersAsync();
    }

    private sealed class UserForm
    {
        public long Id { get; set; }
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public long RoleId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
