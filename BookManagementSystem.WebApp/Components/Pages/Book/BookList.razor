@page "/books"
@attribute [Authorize(Roles = "Librarian")]
@inject ApiClient Api

<PageTitle>Books — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Books</h1>
        <p class="page-subtitle">Browse and manage the book catalog</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--border);border-radius:14px;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="TitleFilter"
                          Label="Search by title"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="AuthorFilter"
                          Label="Search by author"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="long"
                       @bind-Value="CategoryFilter"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="long" Value="0">All categories</MudSelectItem>
                @foreach (var category in Categories)
                {
                    <MudSelectItem T="long" Value="@category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBooksAsync">Search</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearFiltersAsync">Clear</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--border);border-radius:14px;">
    <MudText Typo="Typo.subtitle1" Style="font-weight:700;" Class="mb-3">
        @(Form.Id == 0 ? "Add Book" : "Edit Book")
    </MudText>
    <EditForm Model="Form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="Form.Title"
                              Label="Book title"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="long"
                           @bind-Value="Form.AuthorId"
                           Label="Author"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem T="long" Value="0">Select author</MudSelectItem>
                    @foreach (var author in Authors)
                    {
                        <MudSelectItem T="long" Value="@author.Id">@author.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="long"
                           @bind-Value="Form.CategoryId"
                           Label="Category"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem T="long" Value="0">Select category</MudSelectItem>
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem T="long" Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField @bind-Value="Form.TotalCopies"
                                 Label="Copy count"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(Form.Id == 0 ? "Create" : "Update")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearForm">Clear</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Elevation="0" Style="border:1px solid var(--border);border-radius:14px;overflow:hidden;">
        <MudTable Items="@Books" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Author</MudTh>
                <MudTh>Category</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Available</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Author">@context.AuthorName</MudTd>
                <MudTd DataLabel="Category">@context.CategoryName</MudTd>
                <MudTd DataLabel="Total">@context.TotalCopies</MudTd>
                <MudTd DataLabel="Available">@context.AvailableCopies</MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => Edit(context)" aria-label="Edit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context.Id)" aria-label="Delete" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No books found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<BookListDto> Books { get; set; } = [];
    private List<AuthorDto> Authors { get; set; } = [];
    private List<CategoryDto> Categories { get; set; } = [];
    private BookForm Form { get; set; } = new();
    private string? TitleFilter { get; set; }
    private string? AuthorFilter { get; set; }
    private long CategoryFilter { get; set; }
    private string? Message { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
        await LoadCategoriesAsync();
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        IsLoading = true;
        var queryParameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(TitleFilter))
            queryParameters.Add($"title={Uri.EscapeDataString(TitleFilter.Trim())}");

        if (!string.IsNullOrWhiteSpace(AuthorFilter))
            queryParameters.Add($"author={Uri.EscapeDataString(AuthorFilter.Trim())}");

        if (CategoryFilter > 0)
            queryParameters.Add($"categoryId={CategoryFilter}");

        var url = "api/Book";
        if (queryParameters.Count > 0)
            url += "?" + string.Join("&", queryParameters);

        var result = await Api.GetAsync<List<BookListDto>>(url);
        Books = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
        IsLoading = false;
    }

    private async Task LoadAuthorsAsync()
    {
        var result = await Api.GetAsync<List<AuthorDto>>("api/Author");
        Authors = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
    }

    private async Task LoadCategoriesAsync()
    {
        var result = await Api.GetAsync<List<CategoryDto>>("api/Category");
        Categories = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
    }

    private void Edit(BookListDto book)
    {
        Form = new BookForm
        {
            Id = book.Id,
            Title = book.Title,
            AuthorId = book.AuthorId,
            CategoryId = book.CategoryId,
            TotalCopies = book.TotalCopies
        };
        Message = null;
    }

    private void ClearForm()
    {
        Form = new BookForm();
        Message = null;
    }

    private async Task ClearFiltersAsync()
    {
        TitleFilter = null;
        AuthorFilter = null;
        CategoryFilter = 0;
        await LoadBooksAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.Title))
        {
            Message = "Book title is required.";
            return;
        }

        if (Form.AuthorId <= 0)
        {
            Message = "Please select an author.";
            return;
        }

        if (Form.CategoryId <= 0)
        {
            Message = "Please select a category.";
            return;
        }

        if (Form.TotalCopies <= 0)
        {
            Message = "Copy count must be greater than zero.";
            return;
        }

        var succeeded = false;

        if (Form.Id == 0)
        {
            var result = await Api.PostAsync<long>("api/Book", new CreateBookRequest
            {
                Title = Form.Title,
                AuthorId = Form.AuthorId,
                CategoryId = Form.CategoryId,
                TotalCopies = Form.TotalCopies
            });
            Message = result.Message;
            succeeded = result.IsSuccess;
        }
        else
        {
            var result = await Api.PutAsync<BookDetailDto>($"api/Book/{Form.Id}", new UpdateBookRequest
            {
                Title = Form.Title,
                AuthorId = Form.AuthorId,
                CategoryId = Form.CategoryId,
                TotalCopies = Form.TotalCopies
            });
            Message = result.Message;
            succeeded = result.IsSuccess;
        }

        if (succeeded)
        {
            ClearForm();
            await LoadBooksAsync();
        }
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Book/{id}");
        Message = result.Message;
        if (result.IsSuccess) await LoadBooksAsync();
    }

    private sealed class BookForm
    {
        public long Id { get; set; }
        public string Title { get; set; } = "";
        public long AuthorId { get; set; }
        public long CategoryId { get; set; }
        public int TotalCopies { get; set; }
    }
}
