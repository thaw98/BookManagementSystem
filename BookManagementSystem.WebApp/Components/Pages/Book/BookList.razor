@page "/books"
@attribute [Authorize(Roles = "Librarian")]
@inject ApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Books — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Books</h1>
        <p class="page-subtitle">Browse and manage the book catalog</p>
    </div>
    <MudButton id="@AddTriggerId"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Add Book
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<CreateEntityDialog TModel="BookForm"
                    @bind-IsOpen="_createDialogOpen"
                    Model="@_createForm"
                    EntityLabel="Book"
                    SupportingText="Add a title and its inventory details to the catalog."
                    DialogWidth="MaxWidth.Medium"
                    Submit="CreateBookAsync"
                    OnSuccess="OnBookCreatedAsync"
                    ReturnFocusElementId="@AddTriggerId">
    <FormFields Context="model">
        <MudGrid Spacing="2" Class="bms-dialog-grid">
            <MudItem xs="12">
                <MudTextField @bind-Value="model.Title"
                              For="@(() => model.Title)"
                              Label="Book title"
                              Variant="Variant.Outlined"
                              Required="true"
                              AutoFocus="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="long"
                           @bind-Value="model.AuthorId"
                           For="@(() => model.AuthorId)"
                           Label="Author"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="long" Value="0">Select author</MudSelectItem>
                    @foreach (var author in Authors)
                    {
                        <MudSelectItem T="long" Value="@author.Id">@author.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="long"
                           @bind-Value="model.CategoryId"
                           For="@(() => model.CategoryId)"
                           Label="Category"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="long" Value="0">Select category</MudSelectItem>
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem T="long" Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int"
                                 @bind-Value="model.TotalCopies"
                                 For="@(() => model.TotalCopies)"
                                 Label="Copy count"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Required="true" />
            </MudItem>
        </MudGrid>
    </FormFields>
</CreateEntityDialog>

<EditEntityDialog TModel="BookForm"
                  @bind-IsOpen="_editDialogOpen"
                  Model="@_editForm"
                  EntityLabel="Book"
                  SupportingText="Update catalog details without reducing inventory below current loans."
                  DialogWidth="MaxWidth.Medium"
                  Submit="UpdateBookAsync"
                  OnSuccess="OnBookUpdatedAsync"
                  ReturnFocusElementId="@_editReturnFocusId">
    <FormFields Context="model">
        <MudGrid Spacing="2" Class="bms-dialog-grid">
            <MudItem xs="12">
                <MudTextField @bind-Value="model.Title"
                              For="@(() => model.Title)"
                              Label="Book title"
                              Variant="Variant.Outlined"
                              Required="true"
                              AutoFocus="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="long"
                           @bind-Value="model.AuthorId"
                           For="@(() => model.AuthorId)"
                           Label="Author"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="long" Value="0">Select author</MudSelectItem>
                    @foreach (var author in Authors)
                    {
                        <MudSelectItem T="long" Value="@author.Id">@author.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="long"
                           @bind-Value="model.CategoryId"
                           For="@(() => model.CategoryId)"
                           Label="Category"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="long" Value="0">Select category</MudSelectItem>
                    @foreach (var category in Categories)
                    {
                        <MudSelectItem T="long" Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int"
                                 @bind-Value="model.TotalCopies"
                                 For="@(() => model.TotalCopies)"
                                 Label="Copy count"
                                 Variant="Variant.Outlined"
                                 Min="@Math.Max(1, model.BorrowedCopies)"
                                 Required="true"
                                 HelperText="@BorrowedCopiesHelp(model)" />
            </MudItem>
        </MudGrid>
    </FormFields>
</EditEntityDialog>

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="TitleFilter"
                          Label="Search by title"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="AuthorFilter"
                          Label="Search by author"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="long"
                       @bind-Value="CategoryFilter"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="long" Value="0">All categories</MudSelectItem>
                @foreach (var category in Categories)
                {
                    <MudSelectItem T="long" Value="@category.Id">@category.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBooksAsync">Search</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearFiltersAsync">Clear</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Class="bms-panel" Elevation="0">
        <MudTable Items="@Books" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="bms-table">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Author</MudTh>
                <MudTh>Category</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Available</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Author">@context.AuthorName</MudTd>
                <MudTd DataLabel="Category">@context.CategoryName</MudTd>
                <MudTd DataLabel="Total">@context.TotalCopies</MudTd>
                <MudTd DataLabel="Available">
                    <span class="avail-badge @AvailClass(context.AvailableCopies, context.TotalCopies)">
                        @context.AvailableCopies available
                    </span>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton id="@EditTriggerId(context.Id)"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OpenEditDialog(context)"
                                   aria-label="@($"Edit {context.Title}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => DeleteAsync(context.Id)"
                                   aria-label="@($"Delete {context.Title}")" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No books found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private const string AddTriggerId = "add-book-trigger";
    private List<BookListDto> Books { get; set; } = [];
    private List<AuthorDto> Authors { get; set; } = [];
    private List<CategoryDto> Categories { get; set; } = [];
    private BookForm _createForm = new() { TotalCopies = 1 };
    private BookForm _editForm = new();
    private bool _createDialogOpen;
    private bool _editDialogOpen;
    private string? _editReturnFocusId;
    private string? TitleFilter { get; set; }
    private string? AuthorFilter { get; set; }
    private long CategoryFilter { get; set; }
    private string? Message { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
        await LoadCategoriesAsync();
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        IsLoading = true;
        var queryParameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(TitleFilter))
            queryParameters.Add($"title={Uri.EscapeDataString(TitleFilter.Trim())}");

        if (!string.IsNullOrWhiteSpace(AuthorFilter))
            queryParameters.Add($"author={Uri.EscapeDataString(AuthorFilter.Trim())}");

        if (CategoryFilter > 0)
            queryParameters.Add($"categoryId={CategoryFilter}");

        var url = "api/Book";
        if (queryParameters.Count > 0)
            url += "?" + string.Join("&", queryParameters);

        var result = await Api.GetAsync<List<BookListDto>>(url);
        Books = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
        IsLoading = false;
    }

    private async Task LoadAuthorsAsync()
    {
        var result = await Api.GetAsync<List<AuthorDto>>("api/Author");
        Authors = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
    }

    private async Task LoadCategoriesAsync()
    {
        var result = await Api.GetAsync<List<CategoryDto>>("api/Category");
        Categories = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
    }

    private void OpenCreateDialog()
    {
        _createForm = new BookForm { TotalCopies = 1 };
        Message = null;
        _createDialogOpen = true;
    }

    private void OpenEditDialog(BookListDto book)
    {
        _editForm = new BookForm
        {
            Id = book.Id,
            Title = book.Title,
            AuthorId = book.AuthorId,
            CategoryId = book.CategoryId,
            TotalCopies = book.TotalCopies,
            BorrowedCopies = book.TotalCopies - book.AvailableCopies
        };
        _editReturnFocusId = EditTriggerId(book.Id);
        Message = null;
        _editDialogOpen = true;
    }

    private async Task ClearFiltersAsync()
    {
        TitleFilter = null;
        AuthorFilter = null;
        CategoryFilter = 0;
        await LoadBooksAsync();
    }

    private async Task<FormSubmitResult> CreateBookAsync(BookForm form)
    {
        var result = await Api.PostAsync<long>("api/Book", new CreateBookRequest
        {
            Title = form.Title.Trim(),
            AuthorId = form.AuthorId,
            CategoryId = form.CategoryId,
            TotalCopies = form.TotalCopies
        });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task<FormSubmitResult> UpdateBookAsync(BookForm form)
    {
        var result = await Api.PutAsync<BookDetailDto>($"api/Book/{form.Id}", new UpdateBookRequest
        {
            Title = form.Title.Trim(),
            AuthorId = form.AuthorId,
            CategoryId = form.CategoryId,
            TotalCopies = form.TotalCopies
        });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task OnBookCreatedAsync(FormSubmitResult result)
    {
        Message = null;
        await LoadBooksAsync();
        Snackbar.Add(result.Message ?? "Book created successfully.", Severity.Success);
    }

    private async Task OnBookUpdatedAsync(FormSubmitResult result)
    {
        Message = null;
        await LoadBooksAsync();
        Snackbar.Add(result.Message ?? "Book updated successfully.", Severity.Success);
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Book/{id}");
        Message = result.Message;
        if (result.IsSuccess) await LoadBooksAsync();
    }

    private static string BorrowedCopiesHelp(BookForm form) =>
        form.BorrowedCopies == 0
            ? "No copies are currently borrowed."
            : $"At least {form.BorrowedCopies} copies are required because {form.BorrowedCopies} are currently borrowed.";

    private static string EditTriggerId(long id) => $"edit-book-{id}";

    private static string AvailClass(int available, int total)
    {
        if (available <= 0) return "none";
        if (total > 0 && available <= Math.Max(1, total / 4)) return "low";
        return string.Empty;
    }

    private sealed class BookForm : IValidatableObject
    {
        public long Id { get; set; }

        [Required(ErrorMessage = "Book title is required.")]
        public string Title { get; set; } = "";

        [Range(typeof(long), "1", "9223372036854775807", ErrorMessage = "Please select an author.")]
        public long AuthorId { get; set; }

        [Range(typeof(long), "1", "9223372036854775807", ErrorMessage = "Please select a category.")]
        public long CategoryId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Copy count must be greater than zero.")]
        public int TotalCopies { get; set; } = 1;

        public int BorrowedCopies { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (TotalCopies < BorrowedCopies)
            {
                yield return new ValidationResult(
                    $"Copy count cannot be below the {BorrowedCopies} currently borrowed.",
                    [nameof(TotalCopies)]);
            }
        }
    }
}
