@page "/categories"
@attribute [Authorize(Roles = "Librarian")]
@inherits ServerPagedComponentBase<CategoryDto>
@inject ApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Categories — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Organize books by category</p>
    </div>
    <MudButton id="@AddTriggerId"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Add Category
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<CreateEntityDialog TModel="CategoryForm"
                    @bind-IsOpen="_createDialogOpen"
                    Model="@_createForm"
                    EntityLabel="Category"
                    SupportingText="Create a category for organizing the catalog."
                    DialogWidth="MaxWidth.Small"
                    Submit="CreateCategoryAsync"
                    OnSuccess="OnCategoryCreatedAsync"
                    ReturnFocusElementId="@AddTriggerId">
    <FormFields Context="model">
        <MudTextField @bind-Value="model.Name"
                      For="@(() => model.Name)"
                      Label="Category name"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Counter="100"
                      MaxLength="100"
                      AutoFocus="true" />
    </FormFields>
</CreateEntityDialog>

<EditEntityDialog TModel="CategoryForm"
                  @bind-IsOpen="_editDialogOpen"
                  Model="@_editForm"
                  EntityLabel="Category"
                  SupportingText="Update the category name used in the catalog."
                  DialogWidth="MaxWidth.Small"
                  Submit="UpdateCategoryAsync"
                  OnSuccess="OnCategoryUpdatedAsync"
                  ReturnFocusElementId="@_editReturnFocusId">
    <FormFields Context="model">
        <MudTextField @bind-Value="model.Name"
                      For="@(() => model.Name)"
                      Label="Category name"
                      Variant="Variant.Outlined"
                      Required="true"
                      Immediate="true"
                      Counter="100"
                      MaxLength="100"
                      AutoFocus="true" />
    </FormFields>
</EditEntityDialog>

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <div class="d-flex align-center gap-2 flex-wrap">
        <MudTextField T="string"
                      @bind-Value="SearchText"
                      Label="Search category"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Style="max-width:320px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">Search</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearFiltersAsync">Clear</MudButton>
    </div>
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}

<MudPaper Class="bms-panel" Elevation="0">
    <MudTable T="CategoryDto"
              @ref="Table"
              ServerData="LoadServerDataAsync"
              RowsPerPage="10"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Class="bms-table">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="CategoryDto" SortLabel="name">Category Name</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Category Name">@context.Name</MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton id="@EditTriggerId(context.Id)"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="() => OpenEditDialog(context)"
                                   aria-label="@($"Edit {context.Name}")" />
                    <DeleteIconButton DisplayName="@context.Name"
                                      OnDelete="() => DeleteAsync(context.Id)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No categories found.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
            </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string AddTriggerId = "add-category-trigger";
    private CategoryForm _createForm = new();
    private CategoryForm _editForm = new();
    private bool _createDialogOpen;
    private bool _editDialogOpen;
    private string? _editReturnFocusId;
    private string? SearchText { get; set; }
    private string? _appliedSearchText;
    private string? Message { get; set; }

    protected override Task<Result<OffsetPagedResult<CategoryDto>>> FetchPageAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        var queryParameters = new List<string>
        {
            $"page={state.Page + 1}",
            $"pageSize={state.PageSize}"
        };
        if (!string.IsNullOrWhiteSpace(_appliedSearchText))
            queryParameters.Add($"search={Uri.EscapeDataString(_appliedSearchText)}");
        AddSortingParameters(queryParameters, state);

        return Api.GetAsync<OffsetPagedResult<CategoryDto>>(
            "api/Category/paged?" + string.Join("&", queryParameters),
            cancellationToken);
    }

    protected override void OnPageLoadSucceeded() => Message = null;

    protected override void OnPageLoadFailed(string message) => Message = message;

    private async Task SearchAsync()
    {
        _appliedSearchText = string.IsNullOrWhiteSpace(SearchText)
            ? null
            : SearchText.Trim();
        await ReloadFromFirstPageAsync();
    }

    private async Task ClearFiltersAsync()
    {
        SearchText = null;
        _appliedSearchText = null;
        await ReloadFromFirstPageAsync();
    }

    private void OpenCreateDialog()
    {
        _createForm = new CategoryForm();
        Message = null;
        _createDialogOpen = true;
    }

    private void OpenEditDialog(CategoryDto category)
    {
        _editForm = new CategoryForm { Id = category.Id, Name = category.Name };
        _editReturnFocusId = EditTriggerId(category.Id);
        Message = null;
        _editDialogOpen = true;
    }

    private async Task<FormSubmitResult> CreateCategoryAsync(CategoryForm form)
    {
        var result = await Api.PostAsync<long>("api/Category", new CreateCategoryRequest { Name = form.Name.Trim() });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task<FormSubmitResult> UpdateCategoryAsync(CategoryForm form)
    {
        var result = await Api.PutAsync<CategoryDto>(
            $"api/Category/{form.Id}",
            new UpdateCategoryRequest { Name = form.Name.Trim() });
        return new FormSubmitResult(result.IsSuccess, result.Message);
    }

    private async Task OnCategoryCreatedAsync(FormSubmitResult result)
    {
        Message = null;
        await ReloadFromFirstPageAsync();
        Snackbar.Add(result.Message ?? "Category created successfully.", Severity.Success);
    }

    private async Task OnCategoryUpdatedAsync(FormSubmitResult result)
    {
        Message = null;
        await ReloadCurrentPageAsync();
        Snackbar.Add(result.Message ?? "Category updated successfully.", Severity.Success);
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Category/{id}");
        if (result.IsSuccess)
        {
            await ReloadAfterDeleteAsync();
            Snackbar.Add(result.Message ?? "Category deleted successfully.", Severity.Success);
        }
        else
        {
            Message = result.Message;
        }
    }

    private static string EditTriggerId(long id) => $"edit-category-{id}";

    private sealed class CategoryForm
    {
        public long Id { get; set; }

        [Required(ErrorMessage = "Category name is required.")]
        [MaxLength(100, ErrorMessage = "Name cannot exceed 100 characters.")]
        public string Name { get; set; } = "";
    }
}
