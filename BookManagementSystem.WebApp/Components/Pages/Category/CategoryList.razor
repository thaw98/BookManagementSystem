@page "/categories"
@attribute [Authorize(Roles = "Librarian")]
@inject ApiClient Api

<PageTitle>Categories — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Organize books by category</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">@Message</MudAlert>
}

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <h3 class="section-title">@(Form.Id == 0 ? "Add Category" : "Edit Category")</h3>
    <EditForm Model="Form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Form.Name"
                              Label="Category name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(Form.Id == 0 ? "Create" : "Update")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Clear">Clear</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

<MudPaper Class="bms-panel bms-panel-pad mb-4" Elevation="0">
    <MudTextField @bind-Value="SearchText"
                  Label="Search category"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Margin="Margin.Dense"
                  Style="max-width:320px;" />
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Class="bms-panel" Elevation="0">
        <MudTable Items="@FilteredCategories.ToList()" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="bms-table">
            <HeaderContent>
                <MudTh>Category Name</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Category Name">@context.Name</MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => Edit(context)" aria-label="Edit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context.Id)" aria-label="Delete" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4 mud-text-secondary">No categories found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<CategoryDto> Categories { get; set; } = [];
    private CategoryForm Form { get; set; } = new();
    private string? SearchText { get; set; }
    private string? Message { get; set; }
    private bool IsLoading { get; set; }

    private IEnumerable<CategoryDto> FilteredCategories =>
        Categories.Where(x =>
            string.IsNullOrWhiteSpace(SearchText) ||
            x.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        IsLoading = true;
        var result = await Api.GetAsync<List<CategoryDto>>("api/Category");
        Categories = result.Data ?? [];
        if (!result.IsSuccess) Message = result.Message;
        IsLoading = false;
    }

    private void Edit(CategoryDto category)
    {
        Form = new CategoryForm { Id = category.Id, Name = category.Name };
        Message = null;
    }

    private void Clear()
    {
        Form = new CategoryForm();
        Message = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.Name))
        {
            Message = "Category name is required.";
            return;
        }

        if (Form.Id == 0)
        {
            var result = await Api.PostAsync<long>("api/Category", new CreateCategoryRequest { Name = Form.Name });
            Message = result.Message;
            if (!result.IsSuccess) return;
        }
        else
        {
            var result = await Api.PutAsync<CategoryDto>($"api/Category/{Form.Id}", new UpdateCategoryRequest { Name = Form.Name });
            Message = result.Message;
            if (!result.IsSuccess) return;
        }

        Form = new CategoryForm();
        await LoadCategoriesAsync();
    }

    private async Task DeleteAsync(long id)
    {
        var result = await Api.DeleteAsync<bool>($"api/Category/{id}");
        Message = result.Message;
        if (result.IsSuccess) await LoadCategoriesAsync();
    }

    private sealed class CategoryForm
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
    }
}
