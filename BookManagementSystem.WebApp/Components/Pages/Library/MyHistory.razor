@page "/my-history"
@attribute [Authorize(Roles = "Library Member")]

@inject ApiClient Api

<PageTitle>My History — BMS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">My Borrow History</h1>
        <p class="page-subtitle">
            View all books you have borrowed and returned
        </p>
    </div>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="@IsLoading"
               OnClick="LoadHistoryAsync">
        Refresh
    </MudButton>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4"
              Dense="true">
        @Message
    </MudAlert>
}

<MudPaper Class="bms-panel bms-panel-pad mb-4"
          Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="SearchText"
                          Label="Search by title or author"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       @bind-Value="StatusFilter"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="string"
                               Value="@AllStatus">
                    All statuses
                </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@BorrowedStatus">
                    Borrowed
                </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@OverdueStatus">
                    Overdue
                </MudSelectItem>

                <MudSelectItem T="string"
                               Value="@ReturnedStatus">
                    Returned
                </MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12"
                 Class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="ApplyFilters">
                Search
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="ClearFilters">
                Clear
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary"
                       Indeterminate="true"
                       Class="my-4" />
}

<MudPaper Class="bms-panel"
          Elevation="0">
    <MudTable T="BorrowHistoryDto"
              Items="@FilteredHistory"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              RowsPerPage="10"
              Class="bms-table">

        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Author</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Borrowed Date</MudTh>
            <MudTh>Due Date</MudTh>
            <MudTh>Returned Date</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Title">
                @context.BookTitle
            </MudTd>

            <MudTd DataLabel="Author">
                @context.AuthorName
            </MudTd>

            <MudTd DataLabel="Category">
                @context.CategoryName
            </MudTd>

            <MudTd DataLabel="Borrowed Date">
                @FormatDate(context.BorrowedAt)
            </MudTd>

            <MudTd DataLabel="Due Date">
                @FormatDate(context.DueAt)
            </MudTd>

            <MudTd DataLabel="Returned Date">
                @FormatNullableDate(context.ReturnedAt)
            </MudTd>

            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="@StatusColor(context.Status)">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">
                No borrow history found.
            </MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string AllStatus = "All";

    private const string BorrowedStatus = "Borrowed";

    private const string OverdueStatus = "Overdue";

    private const string ReturnedStatus = "Returned";

    private List<BorrowHistoryDto> History { get; set; } = [];

    private List<BorrowHistoryDto> FilteredHistory { get; set; } = [];

    private string? SearchText { get; set; }

    private string StatusFilter { get; set; } = AllStatus;

    private bool IsLoading { get; set; }

    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        IsLoading = true;
        Message = null;

        try
        {
            var result =
                await Api.GetAsync<List<BorrowHistoryDto>>(
                    "api/Borrow/my-history");

            if (result.IsSuccess)
            {
                History = result.Data ?? [];
                ApplyFilters();
                return;
            }

            History = [];
            FilteredHistory = [];
            Message = result.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<BorrowHistoryDto> query = History;

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search = SearchText.Trim();

            query = query.Where(
                x => x.BookTitle.Contains(
                         search,
                         StringComparison.OrdinalIgnoreCase) ||
                     x.AuthorName.Contains(
                         search,
                         StringComparison.OrdinalIgnoreCase) ||
                     x.CategoryName.Contains(
                         search,
                         StringComparison.OrdinalIgnoreCase));
        }

        if (!string.Equals(
                StatusFilter,
                AllStatus,
                StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(
                x => string.Equals(
                    x.Status,
                    StatusFilter,
                    StringComparison.OrdinalIgnoreCase));
        }

        FilteredHistory = query.ToList();
    }

    private void ClearFilters()
    {
        SearchText = null;
        StatusFilter = AllStatus;
        ApplyFilters();
    }

    private static string FormatDate(DateTime date)
    {
        return date.ToLocalTime()
            .ToString("dd-MMM-yyyy");
    }

    private static string FormatNullableDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToLocalTime().ToString("dd-MMM-yyyy")
            : "-";
    }

    private static Color StatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "borrowed" => Color.Success,
            "overdue" => Color.Error,
            "returned" => Color.Default,
            _ => Color.Info
        };
    }
}