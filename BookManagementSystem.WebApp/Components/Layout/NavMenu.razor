<div class="sidebar-brand">
    <div class="brand-logo">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
    </div>
    <div>
        <h2>BMS</h2>
        <span>Library System</span>
    </div>
</div>

<div class="sidebar-nav-label">Menu</div>

<MudNavMenu Class="bms-nav">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="users" Icon="@Icons.Material.Filled.Group">
                Users
            </MudNavLink>
            <MudNavLink Href="roles" Icon="@Icons.Material.Filled.Security">
                Roles
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Librarian">
        <Authorized>
            <MudNavLink Href="authors" Icon="@Icons.Material.Filled.Person">
                Authors
            </MudNavLink>
            <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Category">
                Categories
            </MudNavLink>
            <MudNavLink Href="books" Icon="@Icons.Material.Filled.AutoStories">
                Books
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
