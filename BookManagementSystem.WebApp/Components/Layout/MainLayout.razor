@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationClient NotificationClient
@using Microsoft.AspNetCore.Components.Routing
@using Contracts.Notification

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="bms-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="@(_drawerOpen ? "Collapse navigation" : "Expand navigation")" />
        <div class="topbar-context">
            <div class="topbar-eyebrow">BMS</div>
            <div class="topbar-page">@_pageTitle</div>
        </div>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="topbar-actions">
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" PopoverClass="notification-menu-panel">
                        <ActivatorContent Context="bell">
                            <MudBadge Content="@BadgeText" Visible="@(NotificationClient.UnreadCount > 0)"
                                      Color="Color.Error" Overlap="true" Bordered="true" Class="notification-badge">
                                <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                                               Color="Color.Inherit"
                                               Class="notification-trigger"
                                               OnClick="@((MouseEventArgs e) => bell.ToggleAsync(e))"
                                               aria-label="@($"Notifications, {NotificationClient.UnreadCount} unread")" />
                            </MudBadge>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="notification-header">
                                <div class="notification-heading">
                                    <span class="notification-title">Notifications</span>
                                    @if (NotificationClient.UnreadCount > 0)
                                    {
                                        <span class="notification-count">@NotificationClient.UnreadCount new</span>
                                    }
                                </div>
                                @if (NotificationClient.UnreadCount > 0)
                                {
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Class="notification-mark-all"
                                               OnClick="MarkAllNotificationsReadAsync">
                                        Mark all read
                                    </MudButton>
                                }
                            </div>
                            <MudDivider Class="notification-divider" />
                            <div class="notification-list">
                                @if (NotificationClient.Notifications.Count == 0)
                                {
                                    <div class="notification-empty">
                                        <div class="notification-empty-icon">
                                            <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Medium" />
                                        </div>
                                        <p class="notification-empty-title">No notifications yet</p>
                                        <p class="notification-empty-text">Your notification history will appear here.</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in NotificationClient.Notifications.Take(5))
                                    {
                                        @if (item.ReadAt is null)
                                        {
                                            <button type="button"
                                                    class="notification-item notification-item--unread"
                                                    @onclick="() => MarkNotificationReadAsync(item)"
                                                    aria-label="@($"Unread notification: {item.Title}. Mark as read")">
                                                <span class="@($"notification-item-icon notification-item-icon--{item.Type.ToLowerInvariant()}")">
                                                    <MudIcon Icon="@NotificationIcon(item.Type)" Size="Size.Small" />
                                                </span>
                                                <span class="notification-item-body">
                                                    <span class="notification-item-heading">
                                                        <strong class="notification-item-title">@item.Title</strong>
                                                        <span class="notification-item-unread-dot" aria-hidden="true"></span>
                                                    </span>
                                                    <span class="notification-item-message">@item.Message</span>
                                                    <time class="notification-item-time">@NotificationDateTime.Format(item.CreatedAt)</time>
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="notification-item notification-item--read">
                                                <span class="@($"notification-item-icon notification-item-icon--{item.Type.ToLowerInvariant()}")">
                                                    <MudIcon Icon="@NotificationIcon(item.Type)" Size="Size.Small" />
                                                </span>
                                                <span class="notification-item-body">
                                                    <span class="visually-hidden">Read notification.</span>
                                                    <strong class="notification-item-title">@item.Title</strong>
                                                    <span class="notification-item-message">@item.Message</span>
                                                    <time class="notification-item-time">@NotificationDateTime.Format(item.CreatedAt)</time>
                                                </span>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                            <MudDivider Class="notification-divider" />
                            <div class="notification-footer">
                                <a href="/notifications" class="notification-view-all" aria-label="View all notifications">
                                    View All
                                    <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
                                </a>
                            </div>
                        </ChildContent>
                    </MudMenu>
                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             PopoverClass="profile-menu-panel">
                    <ActivatorContent Context="context">
                        <MudButton Variant="Variant.Text"
                                   Class="profile-trigger"
                                   OnClick="@((MouseEventArgs e) => context.ToggleAsync(e))"
                                   aria-label="Open profile menu">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                @GetInitial(auth.User)
                            </MudAvatar>
                            <MudHidden Breakpoint="Breakpoint.Xs">
                                <div class="profile-meta">
                                    <span class="name">@GetEmail(auth.User)</span>
                                    <span class="role-badge @GetRoleCss(auth.User)">@GetRole(auth.User)</span>
                                </div>
                            </MudHidden>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="profile-chevron" />
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="pd-header">
                            <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                @GetInitial(auth.User)
                            </MudAvatar>
                            <div class="pd-identity">
                                <div class="pd-name">@GetEmail(auth.User)</div>
                                <div class="pd-email">@GetRole(auth.User)</div>
                                <span class="role-badge @GetRoleCss(auth.User)">@GetRole(auth.User)</span>
                            </div>
                        </div>
                        <MudDivider Class="my-1" />
                        <MudButton Href="/profile"
                                   Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Person"
                                   Class="pd-action pd-profile">
                            Profile
                        </MudButton>
                        <form method="post" action="/account/logout" class="pd-action-form">
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Logout"
                                       Class="pd-action pd-signout">
                                Logout
                            </MudButton>
                        </form>
                    </ChildContent>
                    </MudMenu>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="0"
               Variant="@DrawerVariant.Mini"
               OpenMiniOnHover="false"
               Class="bms-drawer"
               Breakpoint="Breakpoint.Md"
               aria-label="Primary navigation">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="content-pad">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    private string _pageTitle = "Dashboard";
    private bool _notificationsInitialized;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563eb",
            PrimaryContrastText = "#ffffff",
            Secondary = "#64748b",
            AppbarBackground = "#ffffff",
            AppbarText = "#111827",
            Background = "#f3f4f6",
            Surface = "#ffffff",
            DrawerBackground = "#eef1f6",
            DrawerText = "#3a4556",
            DrawerIcon = "#7b8798",
            Success = "#10b981",
            Error = "#ef4444",
            TextPrimary = "#111827",
            TextSecondary = "#6b7280",
            ActionDefault = "#6b7280",
            LinesDefault = "#e5e7eb"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"]
            },
            H1 = new H1Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "800" },
            H2 = new H2Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "800" },
            H3 = new H3Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "700" },
            H4 = new H4Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "700" },
            H5 = new H5Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "700" },
            H6 = new H6Typography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "700" },
            Button = new ButtonTypography { FontFamily = ["Plus Jakarta Sans", "Helvetica", "Arial", "sans-serif"], FontWeight = "600", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
            DrawerWidthLeft = "272px",
            DrawerMiniWidthLeft = "72px",
            AppbarHeight = "64px"
        }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        NotificationClient.StateChanged += OnNotificationStateChanged;
        _pageTitle = ResolveTitle(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_notificationsInitialized)
        {
            _notificationsInitialized = true;
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await NotificationClient.InitializeAsync(state.User);
        }
    }

    private void OnNotificationStateChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task MarkNotificationReadAsync(NotificationDto item)
    {
        if (item.ReadAt is null) await NotificationClient.MarkReadAsync(item.Id);
    }
    private async Task MarkAllNotificationsReadAsync() => await NotificationClient.MarkAllReadAsync();
    private string BadgeText => NotificationClient.UnreadCount > 99 ? "99+" : NotificationClient.UnreadCount.ToString();
    private static string NotificationIcon(string type) => type switch
    {
        "Borrowed" => Icons.Material.Outlined.MenuBook,
        "Returned" => Icons.Material.Outlined.AssignmentReturned,
        "DueSoon" => Icons.Material.Outlined.Schedule,
        "Overdue" => Icons.Material.Outlined.WarningAmber,
        _ => Icons.Material.Outlined.Notifications
    };

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _pageTitle = ResolveTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private static string ResolveTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "" or "home" => "Dashboard",
            "users" => "Users",
            "roles" => "Roles",
            "profile" => "Profile",
            "books" => "Books",
            "authors" => "Authors",
            "categories" => "Categories",
            "notifications" => "Notifications",
            _ => "BMS"
        };
    }

    private static string GetEmail(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";

    private static string GetRoleCss(System.Security.Claims.ClaimsPrincipal user)
    {
        var role = GetRole(user).ToLowerInvariant();
        return role switch
        {
            "admin" => "admin",
            "librarian" => "librarian",
            _ => "member"
        };
    }

    private static string GetInitial(System.Security.Claims.ClaimsPrincipal user)
    {
        var email = GetEmail(user);
        return string.IsNullOrWhiteSpace(email) ? "?" : email[0].ToString().ToUpperInvariant();
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        NotificationClient.StateChanged -= OnNotificationStateChanged;
        await NotificationClient.DisposeAsync();
    }
}
